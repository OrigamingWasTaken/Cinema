# Synology user ID (run `id` on the NAS to find it)
PUID=1000
# Synology group ID
PGID=1000
# Timezone
TZ=Europe/Zurich
# Path to the data volume on the NAS (movies live in ${DATA_PATH}/movies)
DATA_PATH=/volume1/cinema/data
# Path for per-service config directories
CONFIG_PATH=/volume1/cinema/config
# TMDB API read access token (required)
TMDB_TOKEN=
# Sonarr API key (optional; read from Sonarr's config if empty)
SONARR_API_KEY=
# TMDB metadata language
TMDB_LANGUAGE=en-US
# WebDAV username (auth is on only when DAV_USER and DAV_PASSWORD are both set)
DAV_USER=
# WebDAV password
DAV_PASSWORD=
# Config path of the v1 stack (used when migrating Prowlarr/Radarr settings)
V1_CONFIG_PATH=/volume1/cinema/Cinema-feat-cinema-stack/config
# mDNS name phones use (http://cinema.local via the DSM reverse proxy rule)
CINEMA_HOSTNAME=cinema.local
# NAS LAN IP for the mDNS name (leave empty to auto-detect)
NAS_IP=
# Tailscale auth key (optional; without it setup prints a login link to open once)
TS_AUTHKEY=
