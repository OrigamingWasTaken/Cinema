# Synology user ID (run `id` on the NAS to find it)
PUID=
# Synology group ID
PGID=
# Timezone
TZ=Europe/Zurich
# Path to the data volume on the NAS (movies live in ${DATA_PATH}/movies)
DATA_PATH=/volume1/cinema/data
# Path for per-service config directories
CONFIG_PATH=/volume1/cinema/config
# TMDB API read access token (required)
TMDB_TOKEN=
# TMDB metadata language
TMDB_LANGUAGE=en-US
# WebDAV username (leave empty to disable auth)
DAV_USER=
# WebDAV password
DAV_PASSWORD=
# Config path of the v1 stack (used when migrating Prowlarr/Radarr settings)
V1_CONFIG_PATH=/volume1/cinema/Cinema-feat-cinema-stack/config
